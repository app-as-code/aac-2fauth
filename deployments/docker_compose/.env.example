# Copy to .env and set every CHANGE_ME:  cp .env.example .env

# SECRET - set a strong value
APP_KEY=CHANGE_ME

# REQUIRED - set for your environment
APP_URL=CHANGE_ME

# REQUIRED - set for your environment
AUTHENTICATION_GUARD=CHANGE_ME

# REQUIRED - set for your environment
MAIL_FROM_ADDRESS=CHANGE_ME

# REQUIRED - set for your environment
MAIL_HOST=CHANGE_ME

# SECRET - set a strong value
MAIL_PASSWORD=CHANGE_ME

# REQUIRED - set for your environment
MAIL_USERNAME=CHANGE_ME

# REQUIRED - set for your environment
OPENID_AUTHORIZE_URL=CHANGE_ME

# REQUIRED - set for your environment
OPENID_CLIENT_ID=CHANGE_ME

# SECRET - set a strong value
OPENID_CLIENT_SECRET=CHANGE_ME

# SECRET - set a strong value
OPENID_TOKEN_URL=CHANGE_ME

# REQUIRED - set for your environment
OPENID_USERINFO_URL=CHANGE_ME

# REQUIRED - set for your environment
REDIS_HOST=CHANGE_ME

# REQUIRED - set for your environment
SITE_OWNER=CHANGE_ME

# REQUIRED - set for your environment
WEBAUTHN_ICON=CHANGE_ME

# REQUIRED - set for your environment
WEBAUTHN_ID=CHANGE_ME

# REQUIRED - set for your environment
