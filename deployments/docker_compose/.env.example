# REQUIRED - set for your environment
WEBAUTHN_USER_VERIFICATION=CHANGE_ME

# default: false
APP_DEBUG=false

# default: local
APP_ENV=local

# default: Familie 2FA
APP_NAME=Familie 2FA

# default: log
BROADCAST_DRIVER=log

# default: file
CACHE_DRIVER=file

# default: false
IS_DEMO_APP=false

# default: 5
LOGIN_THROTTLE=5

# default: daily
LOG_CHANNEL=daily

# default: notice
LOG_LEVEL=notice

# default: log
MAIL_DRIVER=log

# default: TLS
MAIL_ENCRYPTION=TLS

# default: Backend 2FA
MAIL_FROM_NAME=Backend 2FA

# default: 465
MAIL_PORT=465

# default: true
MAIL_VERIFY_SSL_PEER=true

# default: local
MIX_ENV=local

# default: null
PROXY_FOR_OUTGOING_REQUESTS=null

# default: sync
QUEUE_DRIVER=sync

# default: 6379
REDIS_PORT=6379

# default: file
SESSION_DRIVER=file

# default: 120
SESSION_LIFETIME=120

# default: 60
THROTTLE_API=60

# default: *
TRUSTED_PROXIES=*
